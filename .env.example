# Copy this file to .env and fill in your real values.
# Do not commit .env.

TMDB_BEARER_TOKEN=your_tmdb_api_read_access_token_here
S3_BUCKET_NAME=movie-pipeline-landing

# Docker also mounts ~/.aws read-only, so these are only needed when you do not
# use the credentials stored by `aws configure`. For temporary credentials,
# also set AWS_SESSION_TOKEN.
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_DEFAULT_REGION=your_aws_region
# AWS_SESSION_TOKEN=your_optional_session_token

# Airflow local Docker settings.
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Airflow reads this connection as "snowflake_conn". Keep the JSON on one line.
AIRFLOW_CONN_SNOWFLAKE_CONN={"conn_type":"snowflake","login":"your_snowflake_username","password":"your_snowflake_password","schema":"DEV","extra":{"account":"your_account_identifier","database":"MOVIE_DB","warehouse":"COMPUTE_WH","role":"ACCOUNTADMIN"}}

# Each stage already points at its source-specific S3 prefix.
IMDB_SNOWFLAKE_STAGE=MOVIE_DB.RAW.IMDB_STAGE
TMDB_SNOWFLAKE_STAGE=MOVIE_DB.RAW.TMDB_STAGE
IMDB_SNOWFLAKE_FILE_FORMAT=MOVIE_DB.RAW.IMDB_TSV_FORMAT
TMDB_SNOWFLAKE_FILE_FORMAT=MOVIE_DB.RAW.TMDB_CSV_FORMAT

# Optional. Defaults already point to this project's scripts/output_* folders.
# TMDB_OUTPUT_DIR=/Users/pragyaapurva/Documents/SJSU/movie-analytics-pipeline/scripts/output_tmdb
# IMDB_OUTPUT_DIR=/Users/pragyaapurva/Documents/SJSU/movie-analytics-pipeline/scripts/output_imbd
